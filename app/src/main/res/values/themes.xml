<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main application theme -->
    <style name="Theme.WeatherForecastApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Exact match for splash background to prevent white/black flash -->
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.WeatherForecastApp</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>